<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Los tests corren contra MySQL, igual que producción. En SQLite nunca
             pasaron: varias migraciones usan sintaxis propia de MySQL (NOW(),
             CONCAT() en columnas generadas), así que la suite Feature se caía
             entera por el motor y no por el código. La BD `greatbaby_test` se
             crea vacía y RefreshDatabase la migra en cada corrida. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="greatbaby_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Los observers empujan a SIIGO en cuanto se crea una factura o una
             recepción, así que sin esto los tests intentan salir a internet y
             mueren con "Credenciales SIIGO no configuradas". En `fake` el cliente
             responde simulado y el flujo se ejercita igual. -->
        <env name="SIIGO_DRIVER" value="fake"/>
        <!-- Nunca heredar el driver ni el token de Dropi del .env local: con
             DROPI_DRIVER=api los tests del driver web hablaban con Dropi real. -->
        <env name="DROPI_DRIVER" value="mock"/>
        <env name="DROPI_API_KEY" value=""/>
        <env name="DROPI_WEB_SYNC" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
